{
  "name": "internet-mcp",
  "version": "0.1.0",
  "description": "Production-grade Internet access server for local LLMs via the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "internet-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:http": "cross-env TRANSPORT=http node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "search",
    "internet",
    "ai",
    "web-retrieval"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "jsdom": "^26.1.0",
    "pino": "^9.6.0",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.5",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}