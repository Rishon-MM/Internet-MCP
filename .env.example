# ─────────────────────────────────────────────
# Internet MCP — Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and adjust values.

# ── Search Provider ──────────────────────────
# Which search provider to use: searxng | brave | tavily
SEARCH_PROVIDER=searxng

# ── SearXNG ──────────────────────────────────
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT=5000
SEARXNG_SAFE_SEARCH=0

# ── Cache TTL (seconds) ─────────────────────
# Per content type. Set to 0 to disable caching.
SEARCH_CACHE_TTL=300
PAGE_CACHE_TTL=86400
DOC_CACHE_TTL=86400
PDF_CACHE_TTL=2592000

# ── Cache Limits ─────────────────────────────
CACHE_MAX_ENTRIES=500

# ── Transport ────────────────────────────────
# stdio = local MCP clients (Claude Desktop, VS Code, Open WebUI)
# http  = remote/networked access via Streamable HTTP
TRANSPORT=stdio
HTTP_PORT=3000

# ── Fetch ────────────────────────────────────
FETCH_TIMEOUT=15000
FETCH_MAX_SIZE=5242880

# ── Logging ──────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Connectors ──────────────────────────────
# Shared settings for data connectors (weather, currency, crypto, etc.)
CONNECTOR_USER_AGENT=internet-mcp/0.1.0
CONNECTOR_FETCH_TIMEOUT=10000
CONNECTOR_CACHE_TTL=300

# ── CoinGecko (optional) ────────────────────
# Free Demo API key for higher rate limits (100 calls/min vs ~10-30 keyless).
# Get yours at: https://www.coingecko.com/en/api/pricing
# COINGECKO_API_KEY=your_key_here
